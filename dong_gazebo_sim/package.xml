  <version>0.1.0</version>
  <description>Gazebo Classic 仿真：Go2 简化模型 + Livox Mid-360 + IMU，对接 FAST-LIO 与 navmid360 导航栈</description>
  <maintainer email="user@todo.todo">navmid360</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ros2_livox_simulation</exec_depend>
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_ros_pkgs</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
