<?xml version="1.0"?>
<robot name="go2_mid360_sim" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find ros2_livox_simulation)/urdf/mid360.xacro"/>
  <xacro:include filename="$(find dong_gazebo_sim)/urdf/go2_mid360_sim.gazebo.xacro"/>

  <material name="body_gray">
    <color rgba="0.55 0.58 0.62 1.0"/>
  </material>

  <link name="base_link">
    <inertial>
      <mass value="12.0"/>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <inertia ixx="0.08" ixy="0" ixz="0" iyy="0.25" iyz="0" izz="0.27"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.42 0.22 0.12"/>
      </geometry>
      <material name="body_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.42 0.22 0.12"/>
      </geometry>
    </collision>
  </link>

  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <!-- 与 dong_octomap/config/mid360_go2_up.yaml 中雷达相对 IMU 大致一致 -->
    <origin xyz="-0.011 -0.02329 0.10412" rpy="0 0 0"/>
  </joint>

  <!-- Mid-360：话题 livox/lidar -> /livox/lidar；点云 frame 为 livox_frame -->
  <xacro:mid360 name="livox_frame" parent="base_link" topic="livox/lidar">
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </xacro:mid360>

</robot>
