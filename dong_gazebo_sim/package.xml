<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dong_gazebo_sim</name>
  <version>0.1.0</version>
  <description>Gazebo Classic：Go2 + Livox Mid-360 仿真，对接 FAST-LIO2-Localization 与 go2_nav_stack</description>
  <maintainer email="user@todo.todo">navmid360</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ros2_livox_simulation</exec_depend>
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_ros_pkgs</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>go2_description</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>dong_octomap</exec_depend>
  <exec_depend>fast_lio</exec_depend>
  <exec_depend>icp_relocalization</exec_depend>
  <exec_depend>go2_nav_stack</exec_depend>
  <exec_depend>octo_planner</exec_depend>
  <exec_depend>topic_tools</exec_depend>

  <!-- robot_model:=legged 时需先 sync_go2_champ_gazebo.sh + build_go2_champ_gazebo.sh -->
  <!-- exec_depend: go2_config champ_bringup champ_gazebo go2_description -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
